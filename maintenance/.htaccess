# Maintenance — aucun fichier de /new-prasmesti/ n'est servi.
#
# Toute requête du répertoire — page, route de la SPA, asset JS/CSS/image resté
# sur le serveur d'un déploiement précédent (le dépôt SFTP n'efface jamais) —
# est réécrite vers 503.php, qui répond « 503 Service Unavailable » avec la page
# d'indisponibilité. Réécriture interne, donc l'URL demandée n'est jamais servie.
#
# Pour rétablir : supprimer ce fichier sur le serveur (le SFTP ne supprime pas,
# il survivrait à un simple revert) et rétablir l'étape de build dans
# .github/workflows/deploy.yml.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Tout sauf 503.php lui-même — sans cette exclusion, la réécriture se
  # relancerait sur sa propre cible.
  RewriteRule !^503\.php$ /new-prasmesti/503.php [L]
</IfModule>

# Filets si mod_rewrite venait à manquer : pas de listing du répertoire, et
# c'est 503.php qui répond à la racine (index.html, la page servie par
# readfile(), n'est là qu'en dernier recours).
Options -Indexes
DirectoryIndex 503.php index.html
